# Razorpay TEST MODE credentials only. Get these from the Razorpay Dashboard
# -> Settings -> API Keys, with "Test Mode" toggled on. Keys must start with
# rzp_test_ — the client refuses to initialize with live keys (see
# src/razorpay_integration/client.py).
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Optional: RazorpayX virtual account number used to fund referral bonus
# payouts in test mode.
RAZORPAYX_ACCOUNT_NUMBER=

# Business cost assumptions used in the evaluation report (INR).
COST_PER_FALSE_POSITIVE=150
